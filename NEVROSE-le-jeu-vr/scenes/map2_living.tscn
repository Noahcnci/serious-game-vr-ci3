[gd_scene load_steps=34 format=3 uid="uid://nevrose_map2_living"]

; ============================================================
; MAP 2 — SALON + CUISINE (fragment 2, GDD §7)
; Pièce 8,0 x 6,0 m, hauteur 2,7 m, murs 0,15 m.
;   x ∈ [-4, 4], z ∈ [-3, 3]
;   Cuisine : le long du mur nord (z = -3)
;   Salon   : moitié sud (z > 0)
;   Fenêtre : mur ouest, centrée x = -4
;   Porte   : mur est (x = +4), z ∈ [1,55, 2,45], h 2,1
; Les meubles Kenney sont instanciés par scripts/map2_living.gd.
; Chaque élément de la coquille a son PROPRE mesh et sa PROPRE collision.
; ============================================================

; ---------- Matériaux (procéduraux, teinte "folie" gérée par map_base) ----------

